#include "main.h"
#include "i2c.h"
#include "gpio.h"
#include "lcd_i2c.h"
#include "power_manager.h"
#include <stdio.h>
#include <string.h>

void SystemClock_Config(void);

PowerManager pm;

int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();

    HAL_Delay(200);
    LCD_Init();
    HAL_Delay(100);
    LCD_Clear();

    PowerManager_Init(&pm);

    char line1[17];
    char line2[17];

    while (1)
    {
        int solar  = 85;
        int backup = 60;

        PowerManager_Update(&pm, solar, backup);

        if (pm.current_state == STATE_SOLAR)
            snprintf(line1, sizeof(line1), "Mode: SOLAR     ");
        else if (pm.current_state == STATE_BACKUP)
            snprintf(line1, sizeof(line1), "Mode: BACKUP    ");
        else
            snprintf(line1, sizeof(line1), "Mode: CHARGING  ");

        LCD_Set_Cursor(0, 0);
        LCD_Send_String(line1);

        snprintf(line2, sizeof(line2), "Sol:%d%% Bak:%d%%  ", solar, backup);

        LCD_Set_Cursor(1, 0);
        LCD_Send_String(line2);

        HAL_Delay(1000);
    }
}

